<Window x:Class="OpenClickToDo.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Click to Do Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#B0000000"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" Background="#AA020617" SizeChanged="RootGrid_SizeChanged">
        <Image x:Name="ScreenshotImage" Stretch="Fill" Opacity="0.42" />
        <Canvas x:Name="OverlayCanvas" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Padding="18,10"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="StatusText"
                       Text="Click an OCR text block."
                       Foreground="#0F172A"
                       FontSize="14" />
        </Border>

        <Border x:Name="ActionPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24"
                Padding="16"
                Visibility="Collapsed"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="SelectedTextPreview"
                           MaxWidth="720"
                           MaxHeight="84"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Foreground="#0F172A" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Copy"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="CopyButton_Click" />
                    <Button Content="Translate"
                            MinWidth="112"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="TranslateButton_Click" />
                    <Button Content="Search"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Click="SearchButton_Click" />
                    <Button Content="Close"
                            MinWidth="92"
                            Padding="14,8"
                            Click="CloseButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

